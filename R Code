For t test:

roup1 <- c(-1.187, -1.187, -1.187)
group2 <- c(0.498, 4.999, -1.018)


t_test_result <- t.test(group1, group2, var.equal = FALSE, conf.level = 0.95)


print(t_test_result)


t_statistic <- t_test_result$statistic
degrees_freedom <- t_test_result$parameter
p_value <- t_test_result$p.value
confidence_interval <- t_test_result$conf.int


cat("T-statistic:", t_statistic, "\n")
cat("Degrees of freedom:", degrees_freedom, "\n")
cat("P-value:", p_value, "\n")
cat("95% Confidence Interval:", confidence_interval[1], "to", confidence_interval[2], "\n")


